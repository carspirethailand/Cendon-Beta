{
  // ชื่อนี้ต้องตรงกับที่หน้าเว็บเรียก: https://spireone-techs.carspirethailand.workers.dev
  "name": "spireone-techs",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-06-27",
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "sp1p-82396",
    // คนในรายชื่อนี้คือผู้ดูแลระบบช่าง: ตรวจใบสมัคร พักช่าง สร้างช่างทดสอบ
    "OWNERS": "anapatmaliwong@gmail.com,carspirethailand@gmail.com",
    "ALLOWED_ORIGINS": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spireone-techs",
      // ได้เลขนี้จากคำสั่ง: npx wrangler d1 create spireone-techs
      "database_id": "REPLACE_WITH_ID_FROM_d1_create",
      "migrations_dir": "migrations"
    }
  ]
}
